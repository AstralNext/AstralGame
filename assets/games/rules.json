{
  "version": 5,
  "games": [
    {
      "id": "minecraft",
      "name": "Minecraft",
      "description": "开局域网世界，客人在本机游戏列表加入",
      "color": "#5D9C3E",
      "icon": "terrain",
      "sgdb_game_id": 38365,
      "icon_asset": "assets/games/minecraft/icon.png",
      "grid_asset": "assets/games/minecraft/grid.png",
      "show_in_picker": true,
      "sort": 10,
      "platforms": {
        "windows": {
          "network": {
            "protocol": "tcp"
          },
          "lan_game_discover": {
            "type": "udp_multicast",
            "multicast": "224.0.2.60:4445",
            "parser": "minecraft_motd",
            "title": "{player} · {game}"
          }
        }
      }
    },
    {
      "id": "raft",
      "name": "Raft",
      "description": "进房后在游戏里搜局域网房间",
      "color": "#2A7F9E",
      "icon": "sailing",
      "steam_app_id": 648800,
      "sgdb_game_id": 18740,
      "icon_asset": "assets/games/raft/icon.png",
      "grid_asset": "assets/games/raft/grid.png",
      "show_in_picker": true,
      "sort": 20,
      "platforms": {
        "windows": {
          "network": {
            "enable_udp_broadcast_relay": true
          },
          "lan_game_discover": {
            "id": "raft_lan",
            "type": "udp_broadcast",
            "port": 6489,
            "parser": "raft_lan",
            "title": "{player} * Astral",
            "label": "Raft"
          },
          "inject": {
            "type": "mono",
            "process": ["Raft.exe"],
            "dll": "AstralRaftNet.dll",
            "namespace": "AstralRaftNet",
            "class": "Loader",
            "method": "Init",
            "delay_seconds": 5
          }
        }
      }
    },
    {
      "id": "forged_alliance",
      "name": "Forged Alliance",
      "description": "大厅联机，房间会出现在本机列表",
      "color": "#3B6EA5",
      "icon": "military_tech",
      "steam_app_id": 9420,
      "sgdb_game_id": 31467,
      "icon_asset": "assets/games/forged_alliance/icon.png",
      "grid_asset": "assets/games/forged_alliance/grid.png",
      "show_in_picker": true,
      "sort": 25,
      "platforms": {
        "windows": {
          "network": {
            "enable_udp_broadcast_relay": true
          },
          "lan_game_discover": {
            "id": "scfa",
            "type": "process_udp",
            "parser": "scfa_lan",
            "beacon_port": 15000,
            "process": ["game.exe", "ForgedAlliance.exe", "SupremeCommander.exe"],
            "window": ["Forged Alliance", "Supreme Commander"],
            "title": "{player} * Astral",
            "label": "Forged Alliance"
          }
        }
      }
    },
    {
      "id": "valheim",
      "name": "Valheim",
      "description": "进房后在游戏里搜局域网房间",
      "color": "#4A6FA5",
      "icon": "ac_unit",
      "steam_app_id": 892970,
      "icon_asset": "assets/games/valheim/icon.png",
      "grid_asset": "assets/games/valheim/grid.png",
      "show_in_picker": true,
      "sort": 50,
      "platforms": {
        "windows": {
          "network": {
            "enable_udp_broadcast_relay": true
          },
          "lan_game_discover": {
            "id": "valheim_lan",
            "type": "udp_broadcast",
            "port": 2460,
            "parser": "valheim_lan",
            "title": "{player} * Astral",
            "label": "Valheim"
          },
          "inject": {
            "type": "mono",
            "process": ["valheim.exe"],
            "dll": "AstralValheimNet.dll",
            "namespace": "AstralValheimNet",
            "class": "Loader",
            "method": "Init",
            "delay_seconds": 8
          }
        }
      }
    },
    {
      "id": "other",
      "name": "其他",
      "description": "只组网，游戏内需自己填 IP 或走原联机",
      "color": "#6B7280",
      "icon": "sports_esports_outlined",
      "show_in_picker": true,
      "sort": 900
    }
  ]
}
