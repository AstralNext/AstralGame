<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\bin\plugin\</OutputPath>
    <DefineConstants>$(DefineConstants);ASTRAL_RAFT</DefineConstants>
    <RaftManaged Condition="'$(RaftManaged)' == '' AND Exists('C:\Users\baika\Downloads\cs\Assembly-CSharp.dll')">C:\Users\baika\Downloads\cs</RaftManaged>
    <RaftManaged Condition="'$(RaftManaged)' == '' AND Exists('E:\Raft\Raft_Data\Managed\Assembly-CSharp.dll')">E:\Raft\Raft_Data\Managed</RaftManaged>
  </PropertyGroup>
  <!-- 引入共享模板，移除同名本地文件（SDK 项目默认包含 ./*.cs） -->
  <ItemGroup>
    <Compile Remove="Loader.cs" />
    <Compile Remove="AstralLog.cs" />
    <Compile Remove="HarmonyBootstrap.cs" />
    <Compile Include="..\..\_astral_plugin_shared\Loader.cs" Link="Loader.cs" />
    <Compile Include="..\..\_astral_plugin_shared\AstralLog.cs" Link="AstralLog.cs" />
    <Compile Include="..\..\_astral_plugin_shared\HarmonyBootstrap.cs" Link="HarmonyBootstrap.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.2.2" />
    <EmbeddedResource Include="lib\0Harmony.dll" LogicalName="0Harmony.dll" />
  </ItemGroup>
  <Target Name="EnsureHarmonyLib" BeforeTargets="PrepareForBuild">
    <MakeDir Directories="$(MSBuildProjectDirectory)\lib" />
    <Copy SourceFiles="$(NuGetPackageRoot)lib.harmony\2.2.2\lib\net45\0Harmony.dll" DestinationFiles="$(MSBuildProjectDirectory)\lib\0Harmony.dll" SkipUnchangedFiles="true" Condition="Exists('$(NuGetPackageRoot)lib.harmony\2.2.2\lib\net45\0Harmony.dll')" />
  </Target>
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RaftManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="com.rlabrecque.steamworks.net">
      <HintPath>$(RaftManaged)\com.rlabrecque.steamworks.net.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PlayFab">
      <HintPath>$(RaftManaged)\PlayFab.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Collections">
      <HintPath>$(RaftManaged)\Unity.Collections.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Netcode.Runtime">
      <HintPath>$(RaftManaged)\Unity.Netcode.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RaftManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RaftManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(RaftManaged)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(RaftManaged)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(RaftManaged)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(RaftManaged)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(RaftManaged)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
