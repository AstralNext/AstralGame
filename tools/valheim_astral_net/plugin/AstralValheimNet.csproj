<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\bin\plugin\</OutputPath>
    <DefineConstants>$(DefineConstants);ASTRAL_VALHEIM</DefineConstants>
    <ValheimManaged Condition="'$(ValheimManaged)' == '' AND Exists('E:\Valheim\valheim_Data\Managed\assembly_valheim.dll')">E:\Valheim\valheim_Data\Managed</ValheimManaged>
    <ValheimManaged Condition="'$(ValheimManaged)' == '' AND Exists('C:\Program Files (x86)\Steam\steamapps\common\Valheim\valheim_Data\Managed\assembly_valheim.dll')">C:\Program Files (x86)\Steam\steamapps\common\Valheim\valheim_Data\Managed</ValheimManaged>
  </PropertyGroup>
  <!-- 引入共享模板，移除同名本地文件（SDK 项目默认包含 ./*.cs） -->
  <ItemGroup>
    <Compile Remove="Loader.cs" />
    <Compile Remove="AstralLog.cs" />
    <Compile Remove="HarmonyBootstrap.cs" />
    <Compile Include="..\..\_astral_plugin_shared\Loader.cs" Link="Loader.cs" />
    <Compile Include="..\..\_astral_plugin_shared\AstralLog.cs" Link="AstralLog.cs" />
    <Compile Include="..\..\_astral_plugin_shared\HarmonyBootstrap.cs" Link="HarmonyBootstrap.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.2.2" />
    <EmbeddedResource Include="lib\0Harmony.dll" LogicalName="0Harmony.dll" />
  </ItemGroup>
  <Target Name="EnsureHarmonyLib" BeforeTargets="PrepareForBuild">
    <MakeDir Directories="$(MSBuildProjectDirectory)\lib" />
    <Copy SourceFiles="$(NuGetPackageRoot)lib.harmony\2.2.2\lib\net45\0Harmony.dll" DestinationFiles="$(MSBuildProjectDirectory)\lib\0Harmony.dll" SkipUnchangedFiles="true" Condition="Exists('$(NuGetPackageRoot)lib.harmony\2.2.2\lib\net45\0Harmony.dll')" />
  </Target>
  <Target Name="CopyDist" AfterTargets="Build">
    <MakeDir Directories="$(MSBuildProjectDirectory)\..\dist" />
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(MSBuildProjectDirectory)\..\dist\AstralValheimNet.dll" />
  </Target>
  <ItemGroup>
    <Reference Include="assembly_valheim">
      <HintPath>$(ValheimManaged)\assembly_valheim.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Splatform">
      <HintPath>$(ValheimManaged)\Splatform.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="com.rlabrecque.steamworks.net">
      <HintPath>$(ValheimManaged)\com.rlabrecque.steamworks.net.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ValheimManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ValheimManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ValheimManaged)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ValheimManaged)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ValheimManaged)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ValheimManaged)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ValheimManaged)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
