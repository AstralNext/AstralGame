<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="3dp"
    android:paddingBottom="3dp">

    <ImageView
        android:id="@+id/overlay_user_avatar"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/overlay_avatar_ring"
        android:contentDescription="@string/overlay_avatar_desc"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/overlay_user_ip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:maxWidth="140dp"
        android:shadowColor="#CC000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="4"
        android:textColor="#F2FFFFFF"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/overlay_user_latency"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:shadowColor="#CC000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="4"
        android:textColor="#FF8BC34A"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
